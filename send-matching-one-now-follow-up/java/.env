# ─────────────────────────────────────────────────────────────
#  Transfer Builder 에서 자동 생성된 .env
#  각 키의 의미/전체 옵션은 같은 폴더의 .env.builder.example 와 README(.ko).md 참고.
#  인증 값(아래 placeholder)은 빌더가 채우지 않습니다 — 직접 입력하세요.
# ─────────────────────────────────────────────────────────────

# Authentication — set ONE of these
INNORIX_API_KEY=
# INNORIX_ACCESS_TOKEN=
# INNORIX_EMAIL=
# INNORIX_PASSWORD=
INNORIX_BASE_URL=https://app.innorix.com
INNORIX_WORKSPACE_ID=

# AXIS 1 — transfer type
TRANSFER_TYPE=send_one
SOURCE_ID=<deviceId>
SOURCE_PATH=C:/data/out
TARGET_ID=<deviceId>
TARGET_PATH=C:/incoming
SOURCE_IS_DIR=true

# AXIS 2 — when it runs
START_WHEN=now
WAIT=true

# AFTER TRANSFER
NOTIFY_EVENTS=started
ON_MESSAGE=true
MESSAGE_TYPE=slack
MESSAGE_NAME=builder-message-slack
MESSAGE_EVENTS=started
# MESSAGE_CONFIG: 이 도구(slack)에 필요한 항목을 채우세요 — GET /api/integrations/rules/slack 참고
MESSAGE_CONFIG={}
ON_VIRUS_SCAN=true
VIRUS_SCAN_TYPE=mcafee
VIRUS_SCAN_NAME=builder-virus-scan-mcafee
# VIRUS_SCAN_CONFIG: 이 도구(mcafee)에 필요한 항목을 채우세요 — GET /api/integrations/rules/mcafee 참고
VIRUS_SCAN_CONFIG={"scanTiming":"before_transfer_source","onDetection":"alert_only","scanScope":"all"}

# FILE OPTIONS
INTEGRITY=true
