# Transfer Builder settings for the combo_builder script (Node.js / Python / Java / C#)
#   cp .env.builder.example .env  ->  edit  ->  run the script in this folder
#
# The builder has two axes; set them with TRANSFER_TYPE and START_WHEN below.
#   TRANSFER_TYPE : who sends to whom   (send_one | send_many | collect | sync)
#   START_WHEN    : when it runs        (now | schedule | repeat | after_previous | external)
# For TRANSFER_TYPE=sync, START_WHEN is ignored; the sync watch settings apply instead.
#
# Booleans: true/false. Blank = not set.

# ── Authentication — set ONE of these ───────────────────────────────────
#   INNORIX_API_KEY       long-lived user API key  -> sent as the  x-api-key  header
#                         (issue it with POST /api/auth/api-keys)
#   INNORIX_ACCESS_TOKEN  short-lived JWT token     -> sent as  Authorization: Bearer
#   INNORIX_EMAIL + INNORIX_PASSWORD               -> the script logs in for a token
INNORIX_API_KEY=
# INNORIX_ACCESS_TOKEN=your-access-token
# INNORIX_EMAIL=you@example.com
# INNORIX_PASSWORD=your-password
# INNORIX_BASE_URL=https://app.innorix.com
# INNORIX_WORKSPACE_ID=
# INNORIX_TIMEOUT=30
# DEBUG=false                # true = print every HTTP request + response (headers, body, status) — use it to diagnose errors like 400 Bad Request

# ════════════════════════════════════════════════════════════════════════
#  AXIS 1 — TRANSFER TYPE
# ════════════════════════════════════════════════════════════════════════
TRANSFER_TYPE=send_one        # send_one | send_many | collect | sync

# ── Devices & paths ──────────────────────────────────────────────────────
# Which keys you set depends on TRANSFER_TYPE. Use each device's deviceId
# (in the product: Devices -> select the device -> the ID at the top-right).
#
# send_one / sync : one source + one target (the four keys below).
SOURCE_ID=<deviceId>
SOURCE_PATH=C:/data/out
TARGET_ID=<deviceId>
TARGET_PATH=C:/incoming
SOURCE_IS_DIR=true            # false when SOURCE_PATH is a single file
NAME=builder-transfer         # automation / transfer name (optional)

# send_many : one source (SOURCE_ID + SOURCE_PATH above) + a list of targets.
#   TARGET_PATHS: one entry = same path for every target, or one per target
#   (same order as TARGET_IDS). If TARGET_IDS/TARGET_PATHS are blank, the single
#   TARGET_ID/TARGET_PATH above is used as a fallback.
TARGET_IDS=                   # e.g. device-b,device-c
TARGET_PATHS=                 # e.g. C:/incoming   (common)   or   C:/in,D:/in

# collect : one target (TARGET_ID + TARGET_PATH above) + a list of sources.
#   SOURCE_PATHS: one entry = same path for every source, or one per source
#   (same order as SOURCE_IDS). If SOURCE_IDS/SOURCE_PATHS are blank, the single
#   SOURCE_ID/SOURCE_PATH above is used as a fallback.
SOURCE_IDS=                   # e.g. branch-01,branch-02
SOURCE_PATHS=                 # e.g. C:/out   (common)   or   C:/out,D:/out

# ════════════════════════════════════════════════════════════════════════
#  AXIS 2 — START WHEN   (ignored when TRANSFER_TYPE=sync)
# ════════════════════════════════════════════════════════════════════════
START_WHEN=now                # now | schedule | repeat | after_previous | external

# now : run immediately. Sent as POST /api/automations with a schedule of
#       type=none, startDateType=now (runs at once); the run's status comes
#       from the automation's execution log.
WAIT=true                     # wait for an immediate transfer to finish and print the result
WAIT_TIMEOUT=3600             # seconds

# schedule : run once at a specific date & time
SCHEDULE_AT=2026-09-10T01:00:00   # ISO datetime (local to SCHEDULE_TZ)

# repeat : run on a recurring cadence
REPEAT_EVERY=day              # hour | day | week | month
REPEAT_HOUR=02                # day / week / month  (hour is ignored for 'hour')
REPEAT_MINUTE=00
REPEAT_AMPM=am                # am | pm
REPEAT_WEEKDAY=monday         # week  : sunday..saturday (or a comma list: mon,wed,fri)
REPEAT_DAY_OF_MONTH=1         # month : 1-31 (or a comma list: 1,15)
REPEAT_RUN_NOW=false          # DEFAULT false = no immediate run, just start on schedule
                              # (script picks the next occurrence). true = also run once now.
REPEAT_START_AT=              # optional: pin an exact first-run ISO time (overrides RUN_NOW)

SCHEDULE_TZ=Asia/Seoul        # timezone for schedule / repeat

# after_previous : run after another automation finishes (workflow chaining)
PREV_AUTOMATION_ID=           # the automationId this one waits for
FLOW_ID=                      # workflow id shared by the chain (blank = auto-generated)

# external : trigger by an external URL request (prints endpoint URL + x-api-key)
FIRE_TRIGGER=false            # true = call the endpoint once right after creating it
# INNORIX_TRIGGER_BASE_URL=   # defaults to INNORIX_BASE_URL

# ── SYNC settings (only when TRANSFER_TYPE=sync) ─────────────────────────
SYNC_DIRECTION=one_way        # one_way | two_way
SYNC_WATCH=file_created       # file_created | file_modified | both  (both needs server support)

# ════════════════════════════════════════════════════════════════════════
#  AFTER TRANSFER   (enable any; may combine)
# ════════════════════════════════════════════════════════════════════════
# Events that fire the integrations below (builder "Timing"):
#   started, completed, paused, resumed, recovered, canceled, error, skipped
NOTIFY_EVENTS=completed,error

# Run API — HTTP call from the automation (a processor; applies to every transfer, now included)
ON_RUN_API=false
RUN_API_URL=https://api.example.com/webhook
RUN_API_METHOD=POST
RUN_API_BODY=                 # optional JSON string, e.g. {"event":"done"}
RUN_API_EVENTS=              # transfer events, comma separated (e.g. completed,error); empty = every event
RUN_API_TYPE=http             # http (call a URL) | command | script
RUN_API_DEVICE=               # which device runs it: source | target | <deviceId>; empty = the transfer's device
RUN_API_NAME=builder-run-api  # processor name
RUN_API_WAIT=false            # wait for the agent to finish the action

# Message / Virus scan / Email create workspace-wide integrations. *_TYPE is the provider,
# *_CONFIG is a JSON object with the provider's fields
# (GET /api/integrations/rules/{type} lists them; the script warns if a required one is missing).
# Monitoring is different (spec v2.0.0): it is attached to the automation as a monitoring
# processor — every transfer here is an automation (now included), so ON_MONITORING applies.

# Message (slack, teams, discord, google_chat, telegram, ...)
ON_MESSAGE=false
MESSAGE_TYPE=slack
MESSAGE_NAME=builder-slack
MESSAGE_CONFIG={"webhookUrl":"https://hooks.slack.com/services/XXX","channel":"#transfers"}

# Virus scan (clamav, mcafee, crowdstrike, kaspersky, microsoft_defender, ...)
ON_VIRUS_SCAN=false
VIRUS_SCAN_TYPE=clamav
VIRUS_SCAN_NAME=builder-clamav
VIRUS_SCAN_CONFIG={}

# Monitoring (grafana, datadog, prometheus, ...) — attached as an automation processor.
#   Selectable events: started, completed, paused, recovered, deviceConnected, deviceDisconnected.
ON_MONITORING=false
MONITORING_TYPE=grafana
MONITORING_NAME=builder-grafana
MONITORING_CONFIG={"baseUrl":"https://grafana.company.com","apiToken":"XXX"}

# Email (ses, sendgrid, email)
ON_EMAIL=false
EMAIL_TYPE=ses
EMAIL_NAME=builder-email
EMAIL_CONFIG={}

# ════════════════════════════════════════════════════════════════════════
#  FILE OPTIONS
# ════════════════════════════════════════════════════════════════════════
# Type Filter — extension list + allow/deny
FILTER_EXT=                   # e.g. mp4,pdf   (blank = no type filter)
FILTER_MODE=allow             # allow = only these pass ; deny = these are blocked

# Size Filter — min and/or max, in megabytes
FILTER_MIN_MB=                # keep files >= this size, e.g. 1
FILTER_MAX_MB=                # keep files <= this size, e.g. 500

# Name Filter — skip files whose name contains this text
FILTER_EXCLUDE=

# Save Path — keep the source folder structure, optionally in a named subfolder
#   false | root (preserve only) | date (run-date subfolder) | device (device-name) | custom
#   date/device/custom add a subfolder and apply to AUTOMATIONS only (not immediate transfers)
SAVE_PATH=false               # false/root = no subfolder | date | device (per SOURCE device name) | custom
SAVE_PATH_NAME=               # subfolder name when SAVE_PATH=custom
SAVE_PATH_DATE_FORMAT=        # date-subfolder format for SAVE_PATH=date (default yymmdd)
APPEAR_WAIT=120               # seconds to wait for an immediate run to start; nothing started = non-zero exit

# Duplicated Name — what to do on a name conflict
DUPLICATE_ACTION=overwrite    # overwrite | rename | skip   (builder terms; = overwrite | numbering | nosend)

# Integrity — verify each file after the transfer
INTEGRITY=false
